#!/usr/bin/env bash

set -euo pipefail

PROG=$(basename "$0")

usage() {
    cat <<EOF
Usage: $PROG <repo> <studentlist.tsv>

Clone each student's forked repository to the current directory.

Arguments:
  repo             Source repository in OWNER/REPO format (e.g., utm-lowe/cs325-work)
  studentlist.tsv  Tab-separated file: column 1 = GitHub username, column 2 = course tag

For each student, this script will clone OWNER/REPO-TAG into a local
subdirectory named REPO-TAG.

Requirements:
  gh CLI must be installed and authenticated.

Example:
  $PROG utm-lowe/cs325-work students.tsv
EOF
}

if [[ $# -ne 2 ]]; then
    usage >&2
    exit 1
fi

REPO="$1"
STUDENT_FILE="$2"

if [[ ! "$REPO" =~ ^[^/]+/[^/]+$ ]]; then
    echo "$PROG: error: repo must be in OWNER/REPO format, got: $REPO" >&2
    exit 1
fi

if [[ ! -f "$STUDENT_FILE" ]]; then
    echo "$PROG: error: student file not found: $STUDENT_FILE" >&2
    exit 1
fi

ORG="${REPO%%/*}"
REPO_NAME="${REPO##*/}"

while IFS=$'\t' read -r username tag _rest; do
    [[ -z "$username" || -z "$tag" ]] && continue

    FORK_NAME="${REPO_NAME}-${tag}"
    FORK_REPO="${ORG}/${FORK_NAME}"

    echo "[$username] Cloning $FORK_REPO"
    if ! gh repo clone "$FORK_REPO" 2>&1; then
        echo "[$username] Warning: clone failed for $FORK_REPO" >&2
        continue
    fi

    echo "[$username] Done."
done < "$STUDENT_FILE"

echo "All students processed."
